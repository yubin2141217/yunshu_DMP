{
  "frameworkId": "admin",
  "theme": "arco",
  "version": "1.1.0",
  "syncedAt": "2026-08-07",
  "description": "本框架 page-type → 样板文件映射。增页以本文件为准；跨框架统一 page-type id，路径由各库各自 catalog 定义。",
  "reuse": {
    "default": "copy-page-sample",
    "rules": [
      "scaffold 默认 lean：按本 catalog 从框架根目录整页复制 html + js + css（三件套）",
      "必须继承样板已优化的 DOM 与 pro-* / general-card 类名；禁止丢开样板用裸 Arco（如 layout=inline 筛选）重写",
      "在样板结构上按业务改：筛选字段、表格列、状态机、主/次操作、详情分区、mock；禁止只换文案的换皮",
      "复用框架共享层：Shell（boot/shell/mountProPage）、css/pages-common.css、css/arco-theme-pro.css、js/charts/*",
      "样板缺控件时，从 componentShowcases 指向的演示页抄用法与类名",
      "禁止将 component-* 演示页直接改名作为业务交付页"
    ],
    "componentShowcases": {
      "basic": "component-basic",
      "extended": "component-extended",
      "form": "component-form",
      "formExtended": "component-form-extended",
      "tableExtended": "component-table-extended",
      "list": "component-list",
      "chart": "component-chart",
      "chartExtended": "component-chart-extended",
      "richText": "component-rich-text",
      "metricCard": "component-metric-card",
      "chartPalette": "component-chart-palette"
    }
  },
